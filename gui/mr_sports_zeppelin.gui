types mr_main_sports_panel_types {

	type mr_sports_zeppelin_panel = fullscreen_block_window {
		name = "mr_sports_zeppelin_panel"
		datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"

		visible = "[GetVariableSystem.HasValue('com_open_window', 'mr_sports_zeppelin')]"

		blockoverride "animation_state_block" {
			state = {
				name = _show
				# Close open panel before showing this one
				on_start = "[InformationPanelBar.ClosePanel]"
				on_start = "[MapListPanelManager.CloseCurrentPanel]"
				# Fullscreen panels hide topbar
				on_finish = "[GetVariableSystem.Set('com_fullscreen', 'com_fullscreen')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_world_80"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_vfx_war_100"
				}
			}

			state = {
				name = _hide
				on_start = "[GetVariableSystem.Clear('zeppelin_slot_1_selection')]"
				on_start = "[GetVariableSystem.Clear('zeppelin_slot_2_selection')]"
				on_start = "[GetVariableSystem.Clear('zeppelin_slot_3_selection')]"
				on_start = "[GetVariableSystem.Clear('zeppelin_slot_4_selection')]"
				on_start = "[GetVariableSystem.Clear('zeppelin_slot_5_selection')]"
				on_start = "[GetVariableSystem.Clear('com_fullscreen')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets_stop"
				}
			}
		}

		blockoverride "window_header_name" {
			text = MR_ZEPPELIN
			default_format = "#bold"
		}

		blockoverride "back_button_fullscreen" {
			back_button_large = {
				position = { 11 15 }
				parentanchor = top|left
                onclick = "[GetVariableSystem.Clear('zeppelin_slot_1_selection')]"
                onclick = "[GetVariableSystem.Clear('zeppelin_slot_2_selection')]"
                onclick = "[GetVariableSystem.Clear('zeppelin_slot_3_selection')]"
                onclick = "[GetVariableSystem.Clear('zeppelin_slot_4_selection')]"
                onclick = "[GetVariableSystem.Clear('zeppelin_slot_5_selection')]"
                onclick = "[GetVariableSystem.Set('com_open_window', 'mr_sidebar_button_sports_sgui')]"
				tooltip = "MR_RETURN_SPORTS_TAB_TT"
				input_action = "back"
			}
		}

		close_button_large = {
			name = "tutorial_highlight_close_button"
			parentanchor = top|right
			onclick = "[GetVariableSystem.Clear('zeppelin_slot_1_selection')]"
			onclick = "[GetVariableSystem.Clear('zeppelin_slot_2_selection')]"
			onclick = "[GetVariableSystem.Clear('zeppelin_slot_3_selection')]"
			onclick = "[GetVariableSystem.Clear('zeppelin_slot_4_selection')]"
			onclick = "[GetVariableSystem.Clear('zeppelin_slot_5_selection')]"
			onclick = "[GetVariableSystem.Clear('com_open_window')]"
			onclick = "[GetVariableSystem.Clear('com_alert_action')]"
			onclick = "[GetVariableSystem.Clear('com_fullscreen')]"
			shortcut = "close_window"
			position = { -56 115 }
		}

		blockoverride "close_button_position" {
			visible = no
		}

		blockoverride "fixed_top" {
			flowcontainer = {
				minimumsize = { 100% -1 }
				margin_top = 20

				button = {
					#Button to get back to the Academy of Science
					using = default_button_primary_big_action
					size = { 250 40 }
					raw_text = "MR_RETURN_SPORTS_AND_TOURNAMENTS"
					using = fontsize_medium
					onclick = "[GetVariableSystem.Clear('zeppelin_slot_1_selection')]"
					onclick = "[GetVariableSystem.Clear('zeppelin_slot_2_selection')]"
					onclick = "[GetVariableSystem.Clear('zeppelin_slot_3_selection')]"
					onclick = "[GetVariableSystem.Clear('zeppelin_slot_4_selection')]"
					onclick = "[GetVariableSystem.Clear('zeppelin_slot_5_selection')]"
					onclick = "[GetVariableSystem.Set('com_open_window', 'mr_sidebar_button_sports_sgui')]"
					onclick = "[GetVariableSystem.Set('mr_sports_tab', 'aeronautics')]"
					tooltip = "MR_RETURN_SPORTS_AND_TOURNAMENTS_TT"
				}
			}
		}

		blockoverride "scrollarea_content" {
			flowcontainer = {
				minimumsize = { 100% -1 }
				margin = { 0 20 }
				margin_left = 20
				spacing = 10

				#Left Page
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 10

					#Zeppelin - Main Information
					widget = {
						size = { 650 730 }
						parentanchor = left

						datacontext = "[Country.MakeScope.Var('zeppelin_captain_var')]"

						background = {
							using = entry_bg_simple
						}

						default_header_clean = {
							size = { 650 50 }
							position = { 1 -3 }
							blockoverride "text" {
							}
							textbox = {
								text = "ZEPPELIN_INFORMATION_HEADER_TEXT"
								parentanchor = center
								position = { 0 0 }
								autoresize = yes
								max_width = 190
								elide = right
								using = fontsize_xxl
							}
						}

						flowcontainer = {
							direction = vertical
							ignoreinvisible = yes
							spacing = 10
                            position = { 70 70 }

							widget = {
								size = { 500 250 }

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_passenger_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									parentanchor = center
                                    tooltip = "ZEPPELIN_PASSENGER_ICON_TT"
									size = { 500 250 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/GUI_zeppelin_passenger.dds"
								}

								icon = {
									visible = "[GetScriptedGui('mr_zeppelin_expedition_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									parentanchor = center
                                    tooltip = "ZEPPELIN_EXPEDITION_ICON_TT"
									size = { 500 250 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/GUI_zeppelin_expedition.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_military_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									parentanchor = center
                                    tooltip = "ZEPPELIN_MILITARY_ICON_TT"
									size = { 500 250 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/GUI_zeppelin_military.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_generic_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									parentanchor = center
                                    tooltip = "ZEPPELIN_GENERIC_ICON_TT"
									size = { 500 250 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/GUI_zeppelin_generic.dds"
								}
							}
						}

						widget = {
							size = { 650 730 }

							textbox = {
								text = "MR_ZEPPELIN_NAME"
								position = { 50 340 }
								max_width = 500
								autoresize = yes
								elide = right
								using = fontsize_large
							}

							textbox = {
								text = "MR_ZEPPELIN_YEAR"
								position = { 50 380 }
								max_width = 500
								autoresize = yes
								elide = right
								using = fontsize_large
							}

                            textbox = {
								text = "MR_ZEPPELIN_SIZE"
								position = { 50 420 }
								max_width = 500
								autoresize = yes
								elide = right
								using = fontsize_large
							}

							textbox = {
								text = "MR_ZEPPELIN_SPEED"
                                tooltip = "zeppelin_speed_overview_tt"
								position = { 50 460 }
								max_width = 500
								autoresize = yes
								elide = right
								using = fontsize_large
							}

							textbox = {
								text = "MR_ZEPPELIN_RANGE"
                                tooltip = "zeppelin_range_overview_tt"
								position = { 50 500 }
								max_width = 500
								autoresize = yes
								elide = left
								using = fontsize_large
							}
							
							textbox = {
								text = "MR_ZEPPELIN_ENDURANCE"
                                tooltip = "zeppelin_endurance_overview_tt"
								position = { 50 540 }
								max_width = 500
								autoresize = yes
								elide = left
								using = fontsize_large
							}

							textbox = {
								text = "MR_ZEPPELIN_CAPTAIN"
								position = { 320 340 }
								max_width = 500
								autoresize = yes
								elide = right
								using = fontsize_large
							}

							textbox = {
								text = "MR_ZEPPELIN_ENGINE"
								position = { 320 380 }
								max_width = 500
								autoresize = yes
								elide = right
								using = fontsize_large
							}

							textbox = {
								text = "MR_ZEPPELIN_STRUCTURE"
								position = { 320 420 }
								max_width = 500
								autoresize = yes
								elide = right
								using = fontsize_large
							}

							textbox = {
								text = "MR_ZEPPELIN_FORM"
								position = { 320 460 }
								max_width = 500
								autoresize = yes
								elide = right
								using = fontsize_large
							}

							textbox = {
								text = "MR_ZEPPELIN_CELLS"
								position = { 320 500 }
								max_width = 500
								autoresize = yes
								elide = right
								using = fontsize_large
							}

                            textbox = {
								text = "MR_ZEPPELIN_INVENTION"
								position = { 320 540 }
								max_width = 500
								autoresize = yes
								elide = left
								using = fontsize_large
							}

							#Hydrogen Bar
							default_progressbar_horizontal = {
								layoutpolicy_horizontal = expanding
								visible = "[GetScriptedGui('mr_zeppelin_hydrogen_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								tooltip = "MR_HYDROGEN_BAR_TT"
								size = { 610 35 }
								position = { 20 590 }
								blockoverride "values" {
									min = 0
									max = 6
									value = "[FixedPointToFloat(Country.MakeScope.Var('zeppelin_fuel_var').GetValue)]"
								}
								textbox = {
									text = "MR_HYDROGEN_BAR"
									tooltip = "MR_HYDROGEN_BAR_TT"
									size = { 100% 100% }
									using = fontsize_xl
									align = center
								}
							}

                            #Helium Bar
                            white_progressbar_horizontal = {
                                layoutpolicy_horizontal = expanding
                                visible = "[GetScriptedGui('mr_zeppelin_helium_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
                                tooltip = "MR_HELIUM_BAR_TT"
                                size = { 610 35 }
                                position = { 20 590 }
                                blockoverride "values" {
                                    min = 0
                                    max = 6
                                    value = "[FixedPointToFloat(Country.MakeScope.Var('zeppelin_fuel_var').GetValue)]"
                                }
                                textbox = {
                                    text = "MR_HELIUM_BAR"
                                    tooltip = "MR_HELIUM_BAR_TT"
                                    size = { 100% 100% }
                                    using = fontsize_xl
                                    align = center
                                }
                            }

                            #Change Fuel/Type Buttons
                            flowcontainer = {
                                direction = horizontal
                                ignoreinvisible = yes
                                parentanchor = hcenter
                                spacing = 30
                                position = { 0 665 }

                                #Helium
                                button = {
                                    using = default_button_primary_big_action
                                    size = { 250 40 }
                                    raw_text = "MR_ZEPPELIN_HELIUM_BUTTON"
                                    using = fontsize_medium

                                    datacontext = "[GetScriptedGui('mr_zeppelin_helium_button')]"
                                    onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
                                    visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
                                    enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
                                    tooltip = "MR_ZEPPELIN_HELIUM_BUTTON_TT"
                                    #tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
                                }

                                #Hydrogen
                                button = {
                                    using = default_button_primary_big_action
                                    size = { 250 40 }
                                    raw_text = "MR_ZEPPELIN_HYDROGEN_BUTTON"
                                    using = fontsize_medium

                                    datacontext = "[GetScriptedGui('mr_zeppelin_hydrogen_button')]"
                                    onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
                                    visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
                                    enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
                                    tooltip = "MR_ZEPPELIN_HYDROGEN_BUTTON_TT"
                                    #tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
                                }
                            }
						}
					}
				}

				#Center Page
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 10

					#Zeppelin - Modules
					widget = {
						size = { 500 730 }
						parentanchor = left

						datacontext = "[Country.MakeScope.Var('zeppelin_captain_var')]"

						background = {
							using = entry_bg_simple
						}

						default_header_clean = {
							size = { 500 50 }
							position = { 1 -3 }
							blockoverride "text" {
							}
							textbox = {
								text = "ZEPPELIN_MODULES_HEADER_TEXT"
								parentanchor = center
								position = { 0 0 }
								autoresize = yes
								max_width = 190
								elide = right
								using = fontsize_xxl
							}
						}

						mr_zeppelin_module_stack = {
							position = { 15 55 }
						}
					}
				}

				#Right Page
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 10

					#Arctic Header
					widget = {
						size = { 630 730 }
						parentanchor = left

						datacontext = "[Country.MakeScope.Var('zeppelin_captain_var')]"

						background = {
							using = entry_bg_simple
						}

						default_header_clean = {
							size = { 630 50 }
							position = { 1 -3 }
							blockoverride "text" {
							}
							textbox = {
								text = "ARCTIC_HEADER_TEXT"
								parentanchor = center
								position = { 0 0 }
								autoresize = yes
								max_width = 500
								elide = right
								using = fontsize_xxl
							}
						}

						flowcontainer = {
							direction = vertical
							ignoreinvisible = yes
							spacing = 10
                            position = { 70 80 }

							widget = {
								size = { 510 510 }

								icon = {
									size = { 510 510 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_map.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_arctic_region_nw_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 0 0 }
									size = { 170 170 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_NW.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_arctic_region_nn_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 170 0 }
									size = { 170 170 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_NN.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_arctic_region_ne_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 340 0 }
									size = { 170 170 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_NE.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_arctic_region_ww_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 0 170 }
									size = { 170 170 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_WW.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_arctic_region_pole_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 170 170 }
									size = { 170 170 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_POLE.dds"
								}

                                #Zeppelin Icon for Pole
                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_north_pole_crossed_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 235 235 }
									size = { 50 50 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/zeppelin_icon.dds"
                                    tooltip = "ZEPPELIN_FIRST_POLE_TT"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_arctic_region_ee_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 340 170 }
									size = { 170 170 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_EE.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_arctic_region_sw_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 0 340 }
									size = { 170 170 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_SW.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_arctic_region_ss_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 170 340 }
									size = { 170 170 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_SS.dds"
								}

                                icon = {
									visible = "[GetScriptedGui('mr_zeppelin_arctic_region_se_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									position = { 340 340 }
									size = { 170 170 }
									texture = "gfx/interface/icons/GUI_icons/zeppelin/arctic_map/GUI_zeppelin_arctic_SE.dds"
								}
							}

                            widget = {
                                size = { 510 120 }

                                background = {
                                    using = default_background
                                }
                                background = {
                                    using = frame_small
                                }

                                textbox = {
                                    text = "MR_ZEPPELIN_POLE"
                                    position = { 20 30 }
                                    max_width = 500
                                    autoresize = yes
                                    elide = right
                                    using = fontsize_large
                                }

                                textbox = {
                                    text = "MR_ZEPPELIN_BEAR"
                                    position = { 20 70 }
                                    max_width = 500
                                    autoresize = yes
                                    elide = right
                                    using = fontsize_large
                                }

                                textbox = {
                                    text = "MR_ZEPPELIN_CLOUD"
                                    position = { 250 30 }
                                    max_width = 500
                                    autoresize = yes
                                    elide = right
                                    using = fontsize_large
                                }

                                textbox = {
                                    text = "MR_ZEPPELIN_FOSSIL"
                                    position = { 250 70 }
                                    max_width = 500
                                    autoresize = yes
                                    elide = right
                                    using = fontsize_large
                                }
                            }
						}
					}
				}
			}
		}
	}
}

types mr_zeppelin_module_types {

    # Round module icon with separate open/close hit targets. Only one is visible
    # at a time, so clicking the same module icon toggles its option panel closed.
    type mr_zeppelin_module_icon_button = widget {
        size = { 86 86 }

        button = {
            texture = "gfx/interface/backgrounds/round_frame_dec.dds"
            size = { 100% 100% }
            tooltip = "MR_ZEPPELIN_CHANGE_MODULE_TT"
            using = confirm_button_sound

            # Visible only while this slot's option panel is closed.
            block "module_icon_open_action" {}
        }

        button = {
            texture = "gfx/interface/backgrounds/round_frame_dec.dds"
            size = { 100% 100% }
            tooltip = "MR_ZEPPELIN_CLOSE_SELECTION_TT"
            using = confirm_button_sound

            # Visible only while this slot's option panel is open.
            block "module_icon_close_action" {}
        }
    }

    # Compact option row styled after the vanilla right_click_menu_item.
    type mr_zeppelin_module_choice_button = button {
        name = "mr_zeppelin_module_choice_button"
        align = left|nobaseline
        using = fontsize_large

        block "size" {
            # Four effect lines plus the option title fit inside this row.
            size = { 350 116 }
        }

        block "button" {
            using = default_button
        }

        block "properties" {
            visible = yes
            enabled = yes
        }

        block "choice_icon" {
            icon = {
                parentanchor = top|left
                position = { 14 32 }
                block "texture" {
                    texture = "gfx/interface/icons/GUI_icons/zeppelin/GUI_zeppelin_generic.dds"
                }
                size = { 52 52 }
            }
        }

        # Both textboxes use the same fixed left coordinate and top alignment.
        textbox = {
            parentanchor = top|left
            position = { 78 9 }
            size = { 270 24 }
            align = left|top
            using = fontsize_medium
            block "choice_name" {
                text = "MR_ZEPPELIN_SLOT_SELECTION_OPTION"
            }
        }

        textbox = {
            parentanchor = top|left
            position = { 78 35 }
            size = { 270 74 }
            align = left|top
            using = fontsize_small
            fontsize_min = 11
            multiline = yes
            block "choice_effects" {
                text = "MR_ZEPPELIN_SLOT_SELECTION_EFFECTS"
            }
        }

        block "sound" {
            using = select_button_sound
        }
    }

    # One reusable card for a single Zeppelin module slot.
    type mr_zeppelin_module_card = widget {
        size = { 470 122 }

        background = {
            using = entry_bg_simple
        }

        block "module_icon" {
            icon = {
                texture = "gfx/interface/backgrounds/round_frame_dec.dds"
                position = { 10 18 }
                size = { 86 86 }
                alwaystransparent = yes
            }

            icon = {
                texture = "gfx/interface/icons/GUI_icons/zeppelin/GUI_zeppelin_expedition.dds"
                position = { 28 36 }
                size = { 50 50 }
                alwaystransparent = yes
            }
        }

        textbox = {
            position = { 108 10 }
            max_width = 345
            autoresize = yes
            elide = right
            using = fontsize_large
            block "module_slot_label" {
                text = "MR_ZEPPELIN_SLOT_1"
            }
        }

        textbox = {
            position = { 108 40 }
            max_width = 345
            autoresize = yes
            elide = right
            using = fontsize_medium
            block "module_effects" {
                text = "[GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('zeppelin_slot_1_module_effects')]"
                tooltip = "[GetMetaPlayer.GetPlayedOrObservedCountry.GetCustom('zeppelin_slot_1_module_tt')]"
            }
        }

    }

    # Five Modules
    type mr_zeppelin_module_stack = widget {
        size = { 470 638 }

        flowcontainer = {
            direction = vertical
            spacing = 7
            ignoreinvisible = yes

