types mr_main_sports_panel_types {

	type mr_sports_ballooning_panel = fullscreen_block_window {
		name = "mr_sports_ballooning_panel"
		datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"

		visible = "[GetVariableSystem.HasValue('com_open_window', 'mr_sports_ballooning')]"

		blockoverride "animation_state_block" {
			state = {
				name = _show
				# Close open panel before showing this one
				on_start = "[InformationPanelBar.ClosePanel]"
				on_start = "[MapListPanelManager.CloseCurrentPanel]"
				# Fullscreen panels hide topbar
				on_finish = "[GetVariableSystem.Set('com_fullscreen', 'com_fullscreen')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_world_80"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_vfx_war_100"
				}
			}

			state = {
				name = _hide
				on_start = "[GetVariableSystem.Clear('com_fullscreen')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets_stop"
				}
			}
		}

		blockoverride "window_header_name" {
			text = MR_BALLOONING
			default_format = "#bold"
		}

		blockoverride "back_button_fullscreen" {
			back_button_large = {
				position = { 11 15 }
				parentanchor = top|left
                onclick = "[GetVariableSystem.Set('com_open_window', 'mr_sidebar_button_sports_sgui')]"
				tooltip = "MR_RETURN_SPORTS_TAB_TT"
				input_action = "back"
			}
		}

		close_button_large = {
			name = "tutorial_highlight_close_button"
			parentanchor = top|right
			onclick = "[GetVariableSystem.Clear('com_open_window')]"
			onclick = "[GetVariableSystem.Clear('com_alert_action')]"
			onclick = "[GetVariableSystem.Clear('com_fullscreen')]"
			shortcut = "close_window"
			position = { -56 115 }
		}

		blockoverride "close_button_position" {
			visible = no
		}

		blockoverride "fixed_top" {
			flowcontainer = {
				minimumsize = { 100% -1 }
				margin_top = 20

				button = {
					#Button to get back to the Academy of Science
					using = default_button_primary_big_action
					size = { 250 40 }
					raw_text = "MR_RETURN_SPORTS_AND_TOURNAMENTS"
					using = fontsize_medium
					onclick = "[GetVariableSystem.Set('com_open_window', 'mr_sidebar_button_sports_sgui')]"
					onclick = "[GetVariableSystem.Set('mr_sports_tab', 'main')]"
					tooltip = "MR_RETURN_SPORTS_AND_TOURNAMENTS_TT"
				}
			}
		}

		blockoverride "scrollarea_content" {
			flowcontainer = {
				minimumsize = { 100% -1 }
				margin = { 0 20 }
				margin_left = 20
				spacing = 10

				#Left Page
				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					spacing = 10

					#Balloon Statistics
					widget = {
						size = { 910 450 }
						parentanchor = left

						datacontext = "[Country.MakeScope.Var('santos_balloonist_var')]"

						background = {
							using = entry_bg_simple
						}

						default_header_clean = {
							size = { 910 50 }
							position = { 1 -3 }
							blockoverride "text" {
							}
							textbox = {
								text = "BALLOON_HEADER_TEXT"
								parentanchor = center
								position = { 0 0 }
								autoresize = yes
								max_width = 190
								elide = right
								using = fontsize_xxl
							}
						}

						flowcontainer = {
							direction = vertical
							ignoreinvisible = yes
							spacing = 10
							position = { 180 0 }

							widget = {
								size = { 880 40 }
							}

							flowcontainer = {
								direction = horizontal
								parentanchor = top|hcenter
								ignoreinvisible = yes
								spacing = 30

								widget = {
									size = { 240 380 }

									icon = {
										visible = "[GetScriptedGui('mr_ballooning_tier_1_balloon_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
										parentanchor = center
										size = { 240 380 }
										position = { -140 0 }
										texture = "gfx/interface/icons/GUI_icons/balloons/santos_balloon_tier_1.dds"
									}

									icon = {
										visible = "[GetScriptedGui('mr_ballooning_tier_2_balloon_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
										parentanchor = center
										size = { 205 325 }
										position = { -140 0 }
										texture = "gfx/interface/icons/GUI_icons/balloons/santos_balloon_tier_2.dds"
									}

									icon = {
										visible = "[GetScriptedGui('mr_ballooning_tier_3_balloon_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
										parentanchor = center
										size = { 205 325 }
										position = { -140 0 }
										texture = "gfx/interface/icons/GUI_icons/balloons/santos_balloon_tier_3.dds"
									}
								}

								widget = {
									size = { 610 360 }

									textbox = {
										text = "MR_BALLOON_NAME"
										position = { -130 25 }
										max_width = 250
										autoresize = yes
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "MR_BALLOON_TYPE"
										position = { 175 25 }
										max_width = 250
										autoresize = yes
										elide = left
										using = fontsize_large
									}

									textbox = {
										text = "MR_BALLOON_OWNER"
										position = { -130 65 }
										max_width = 250
										autoresize = yes
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "MR_BALLOON_FLIGHT"
										position = { 175 65 }
										max_width = 250
										autoresize = yes
										elide = left
										using = fontsize_large
									}

									textbox = {
										text = "MR_BALLOON_ALTITUDE"
										position = { -130 105 }
										max_width = 300
										autoresize = yes
										elide = right
										using = fontsize_large
										tooltip = "santos_altitude_bonus_overview_tt"
									}
									textbox = {
										text = "MR_BALLOON_DISTANCE"
										position = { -130 145 }
										max_width = 300
										autoresize = yes
										elide = right
										using = fontsize_large
										tooltip = "santos_distance_bonus_overview_tt"
									}
									textbox = {
										text = "MR_BALLOON_TIME"
										position = { -130 185 }
										max_width = 300
										autoresize = yes
										elide = right
										using = fontsize_large
										tooltip = "santos_time_bonus_overview_tt"
									}

									textbox = {
										text = "MR_BALLOON_ALTITUDE_RECORD"
										position = { 175 105 }
										max_width = 300
										autoresize = yes
										elide = right
										using = fontsize_large
									}
									textbox = {
										text = "MR_BALLOON_DISTANCE_RECORD"
										position = { 175 145 }
										max_width = 300
										autoresize = yes
										elide = right
										using = fontsize_large
									}
									textbox = {
										text = "MR_BALLOON_TIME_RECORD"
										position = { 175 185 }
										max_width = 300
										autoresize = yes
										elide = right
										using = fontsize_large
									}

									#Coal Gas Bar
									gold_progressbar_horizontal = {
										layoutpolicy_horizontal = expanding
										visible = "[GetScriptedGui('mr_ballooning_coal_gas_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
										tooltip = "MR_COAL_GAS_BAR_TT"
										size = { 550 35 }
										position = { -130 235 }
										blockoverride "values" {
											min = 0
											max = 6
											value = "[FixedPointToFloat(Country.MakeScope.Var('santos_balloon_fuel_var').GetValue)]"
										}
										textbox = {
											text = "MR_COAL_GAS_BAR"
											tooltip = "MR_COAL_GAS_BAR_TT"
											size = { 100% 100% }
											using = fontsize_xl
											align = center
										}
									}

									#Hydrogen Bar
									default_progressbar_horizontal = {
										layoutpolicy_horizontal = expanding
										visible = "[GetScriptedGui('mr_ballooning_hydrogen_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
										tooltip = "MR_HYDROGEN_BAR_TT"
										size = { 550 35 }
										position = { -130 235 }
										blockoverride "values" {
											min = 0
											max = 6
											value = "[FixedPointToFloat(Country.MakeScope.Var('santos_balloon_fuel_var').GetValue)]"
										}
										textbox = {
											text = "MR_HYDROGEN_BAR"
											tooltip = "MR_HYDROGEN_BAR_TT"
											size = { 100% 100% }
											using = fontsize_xl
											align = center
										}
									}

									#Change Fuel/Type Buttons
									flowcontainer = {
										direction = horizontal
										ignoreinvisible = yes
										parentanchor = hcenter
										spacing = 30
										position = { -160 300 }

										#Change Type
										button = {
											using = default_button_primary_big_action
											size = { 250 40 }
											raw_text = "MR_BALLOONIST_CHANGE_TYPE_BUTTON"
											using = fontsize_medium

											datacontext = "[GetScriptedGui('mr_balloonist_change_type_button')]"
											onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
											visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
											enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
											#tooltip = "MR_BALLOONIST_CHANGE_TYPE_BUTTON_TT"
											tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
										}

										#Coal Gas
										button = {
											using = default_button_primary_big_action
											size = { 250 40 }
											raw_text = "MR_BALLOONIST_COAL_GAS_BUTTON"
											using = fontsize_medium

											datacontext = "[GetScriptedGui('mr_balloonist_coal_gas_button')]"
											onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
											visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
											enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
											tooltip = "MR_BALLOONIST_COAL_GAS_BUTTON_TT"
										}

										#Hydrogen
										button = {
											using = default_button_primary_big_action
											size = { 250 40 }
											raw_text = "MR_BALLOONIST_HYDROGEN_BUTTON"
											using = fontsize_medium

											datacontext = "[GetScriptedGui('mr_balloonist_hydrogen_button')]"
											onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
											visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
											enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
											#tooltip = "MR_BALLOONIST_HYDROGEN_BUTTON_TT"
											tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
										}

									}
								}
							}
						}
					}

					#Balloon Modifications
					widget = {
						size = { 910 270 }
						parentanchor = left

						background = {
							using = entry_bg_simple
						}

						default_header_clean = {
							size = { 910 50 }
							position = { 1 -3 }
							blockoverride "text" {
							}
							textbox = {
								text = "MR_HEADER_MODIFICATIONS"
								parentanchor = center
								position = { 0 0 }
								autoresize = yes
								max_width = 300
								elide = right
								using = fontsize_xxl
							}
						}
					}
				}

				#Right Page
				scrollbox = {

					size = { 860 730 }
					layoutpolicy_horizontal = growing
					layoutpolicy_vertical = expanding

					scrollbarpolicy_horizontal = always_off
					scrollbarpolicy_vertical = as_needed

					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}

					blockoverride "scrollbox_content" {
						vbox = {
							spacing = 3

							datamodel = "[GetGlobalList('santos_crossings_global_list')]"

							default_header_clean = {
								size = { 800 50 }
								#position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_CROSSINGS"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							santos_balloon_crossing = {}

							item = {
								datacontext = "[Scope.GetScriptContainer]"

								flowcontainer = {
									ignoreinvisible = no
									spacing = 20

									textbox = {
										text = "SANTOS_CROSSING_ITEM_NAME"
										tooltip = "SANTOS_CROSSING_ITEM_TOOLTIP"
										parentanchor = top|left
										size = { 160 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "SANTOS_CROSSING_ITEM_BALLOONIST"
										visible = "[Scope.Var('balloonist').IsSet]"
										parentanchor = top|left
										size = { 210 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "SANTOS_CROSSING_ITEM_COUNTRY"
										visible = "[Scope.Var('balloonist_country').IsSet]"
										parentanchor = top|left
										size = { 150 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "SANTOS_CROSSING_ITEM_YEAR"
										visible = "[Scope.Var('year').IsSet]"
										parentanchor = top|left
										size = { 80 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "SANTOS_CROSSING_ITEM_CHECK"
										visible = "[Scope.Var('year').IsSet]"
										parentanchor = top|left
										size = { 100 25 }
										elide = right
										using = fontsize_large
									}
								}
							}
						}

						widget = {
							size = { 700 350 }

							#Change to Asia/Afria
							button = {
								using = default_button_primary_big_action
								size = { 250 40 }
								position = { 220 10 }
								raw_text = "MR_BALLOONIST_CHANGE_MAPS_AFRICA_BUTTON"
								using = fontsize_medium

								datacontext = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button')]"
								onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
								visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
								#tooltip = "MR_BALLOONIST_CHANGE_TYPE_BUTTON_TT"
								tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
							}

							#Change to Europe/South America
							button = {
								using = default_button_primary_big_action
								size = { 250 40 }
								position = { 220 10 }
								raw_text = "MR_BALLOONIST_CHANGE_MAPS_EUROPE_BUTTON"
								using = fontsize_medium

								datacontext = "[GetScriptedGui('mr_balloonist_change_maps_to_europe_button')]"
								onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
								visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
								#tooltip = "MR_BALLOONIST_CHANGE_TYPE_BUTTON_TT"
								tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetMetaPlayer.GetPlayedOrObservedCountry.MakeScope ).End )]"
							}

							#Europe
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								parentanchor = center
								size = { 300 300 }
								position = { -200 30 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_europe_map.dds"
							}

							#Africa
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_europe_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								parentanchor = center
								size = { 300 300 }
								position = { -200 30 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_africa_map.dds"
							}

							#English Channel
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								size = { 50 50 }
								position = { 88 127 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_easy_balloning.dds"
								tooltip = "SANTOS_CHANNEL_CROSSING_TT"
							}

							#Alps
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								size = { 50 50 }
								position = { 150 185 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_difficult_balloning.dds"
								tooltip = "SANTOS_ALPS_CROSSING_TT"
							}

							#Skagerrak
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								size = { 50 50 }
								position = { 170 65 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_average_balloning.dds"
								tooltip = "SANTOS_SKAGERRAK_CROSSING_TT"
							}

							#Mediterranean Sea
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								size = { 50 50 }
								position = { 180 255 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_average_balloning.dds"
								tooltip = "SANTOS_MEDITERRANEAN_CROSSING_TT"
							}

							#Pyrenees
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								size = { 50 50 }
								position = { 90 210 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_average_balloning.dds"
								tooltip = "SANTOS_PYRENEES_CROSSING_TT"
							}

							#Alps
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_europe_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								size = { 50 50 }
								position = { 155 190 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_difficult_balloning.dds"
								tooltip = "SANTOS_BAB_CROSSING_TT"
							}

							#South America
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								parentanchor = center
								size = { 300 300 }
								position = { 200 30 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_south_america_map.dds"
							}

							#Asia
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_europe_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								parentanchor = center
								size = { 300 300 }
								position = { 200 30 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_asia_map.dds"
							}

							#Rio de la Plata
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								size = { 50 50 }
								position = { 610 170 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_easy_balloning.dds"
								tooltip = "SANTOS_RIO_CROSSING_TT"
							}

							#Andes
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_africa_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								size = { 50 50 }
								position = { 450 130 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_difficult_balloning.dds"
								tooltip = "SANTOS_ANDES_CROSSING_TT"
							}

							#Korea
							icon = {
								visible = "[GetScriptedGui('mr_balloonist_change_maps_to_europe_button').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
								size = { 50 50 }
								position = { 512 182 }
								texture = "gfx/interface/icons/GUI_icons/balloons/santos_easy_balloning.dds"
								tooltip = "SANTOS_KOREA_CROSSING_TT"
							}
						}
					}
				}
			}
		}
	}

	type santos_balloon_crossing = flowcontainer {
		ignoreinvisible = yes
		spacing = 20

		textbox = {
			block "crossing_name" {
				text = "SANTOS_CROSSING_NAME"
			}
			parentanchor = top|left
			size = { 160 25 }
			elide = right
			using = fontsize_large
		}

		textbox = {
			block "crossing_balloonist" {
				text = "SANTOS_CROSSING_BALLOONIST"
			}
			parentanchor = top|left
			size = { 210 25 }
			elide = right
			using = fontsize_large
		}

		textbox = {
			block "crossing_country" {
				text = "SANTOS_CROSSING_COUNTRY"
			}
			parentanchor = top|left
			size = { 150 25 }
			elide = right
			using = fontsize_large
		}

		textbox = {
			block "crossing_year" {
				text = "SANTOS_CROSSING_YEAR"
			}
			parentanchor = top|left
			size = { 80 25 }
			elide = right
			using = fontsize_large
		}

		textbox = {
			block "crossing_check" {
				text = "SANTOS_CROSSING_CHECK"
			}
			parentanchor = top|left
			size = { 100 25 }
			elide = right
			using = fontsize_large
		}
	}
}