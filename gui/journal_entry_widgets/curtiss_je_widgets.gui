#### WIDGETS

### Schneider Trophy Races ###

#Current Race Ranking
flowcontainer = {
	name = "widget_curtiss_schneider_trophy_participant_list"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical

		widget = {
			size = { 100% 10 }
		}

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "CURTISS_SCHNEIDER_TROPHY_PARTICIPANT_COUNTRIES_HEADER"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('curtiss_schneider_trophy_participants_visible')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('curtiss_schneider_trophy_participants_visible'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('curtiss_schneider_trophy_participants_visible')]"
			}
		}

		flowcontainer = {
			visible = "[GetVariableSystem.Exists('curtiss_schneider_trophy_participants_visible')]"
			datamodel = "[JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_participants_list')]"
			minimumsize = { @panel_width -1 }
			maximumsize = { @panel_width -1 }
			direction = vertical
			margin_top = 5

			flowcontainer = {
				direction = vertical

				widget = {
					parentanchor = hcenter
					size = { 500 35 }
					maximumsize = { 500 35 }

					vbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding

						hbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding

							margin_left = 10

							textbox = {
								text = "CURTISS_SCHNEIDER_TROPHY_PARTICIPANT_COUNTRY"
								size = { 280 100% }
								elide = right
								align = nobaseline
								alwaystransparent = yes
								margin_left = 12
							}

							textbox = {
								size = { 200 100% }
								text = "CURTISS_SCHNEIDER_TROPHY_PARTICIPANT_POINTS"
								elide = right
								align = right|nobaseline
								margin_right = 10
							}
						}
					}
				}

				divider_clean = {
					parentanchor = bottom
				}
			}

			item = {
				flowcontainer = {
					direction = vertical

					widget = {
						parentanchor = hcenter
						size = { 500 35 }
						maximumsize = { 500 35 }
						datacontext = "[Scope.GetCountry]"
						visible = "[Scope.GetCountry.IsValid]"

						vbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding

							hbox = {
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding

								margin_left = 10

								tiny_flag = {}

								textbox = {
									text = "[Country.GetNameNoFormatting]"
									size = { 340 100% }
									elide = right
									align = nobaseline
									parentanchor = vcenter
									alwaystransparent = yes
									margin_left = 12
								}

								textbox = {
									size = { 80 100% }
									text = "CURTISS_COUNTRY_SCHNEIDER_TROPHY_POINTS"
									elide = right
									align = right|nobaseline
									margin_right = 10
								}
							}
						}
					}

					divider_clean = {
						parentanchor = bottom
					}
				}
			}
		}
		expand = {}
	}
}

#Total Ranking
