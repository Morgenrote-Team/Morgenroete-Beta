#### WIDGETS

### Schneider Trophy Races ###
flowcontainer = {
	name = "widget_curtiss_schneider_trophy_participant_list"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "CURTISS_SCHNEIDER_TROPHY_PARTICIPANT_COUNTRIES_HEADER"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('curtiss_schneider_trophy_participants_visible')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('curtiss_schneider_trophy_participants_visible'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('curtiss_schneider_trophy_participants_visible')]"
			}
		}

		fixedgridbox = {
			visible = "[GetVariableSystem.Exists('curtiss_schneider_trophy_participants_visible')]"
			datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('curtiss_schneider_trophy_participants_list')]"
			addcolumn = 500
			addrow = 110

			background = {
				texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
				color = { 0.69 0.47 0.33 1 }
				alpha = 0.4

				modify_texture = {
					using = texture_velvet
				}
			}

			item = {
				ep2_meiji_restoration_daimyos_widget = {}
			}
		}
		expand = {}
	}
}