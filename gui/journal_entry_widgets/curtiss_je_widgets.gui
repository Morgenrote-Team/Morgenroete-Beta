#### WIDGETS

@panel_width_minus_30 = 510
@panel_width = 540  				# used to be 460

@layer_width = 500
@layer_height = 52

### Schneider Trophy Races ###

#Current Race Ranking
flowcontainer = {
	name = "widget_curtiss_schneider_trophy_widgets"
	ignoreinvisible = yes
	direction = vertical
	using = default_list_position

	spacing = 10

	widget = {
		size = { 100% 5 }
	}

	#All involved Countries
	com_journal_involved_countries_tiny_flags_with_scrollbar = {
		blockoverride "com_involved_countries_header" {
			default_header_clean_faded = {
				parentanchor = hcenter
				blockoverride "text" {
					text = "CURTISS_PARTICIPANTS_LOC"
				}
				blockoverride "size" {
					size = { 512 45 }
				}
			}
		}
	}

	textbox = {
		autoresize = yes
		text = "[JournalEntry.GetReason]"
		min_width = @panel_width_minus_30
		max_width = @panel_width_minus_30
		multiline = yes
		using = default_list_position
		align = nobaseline
		margin = { 15 15 }

		background = {
			using = entry_bg
		}
	}

	### Victory Ranking ###
	flowcontainer = {
		direction = vertical

		visible = "[GetScriptedGui('curtiss_schneider_trophy_victory_ranking_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.MakeScope).End)]"

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "CURTISS_SCHNEIDER_TROPHY_RANKING_HEADER"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('curtiss_schneider_trophy_ranking_invisible')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[GetVariableSystem.Exists('curtiss_schneider_trophy_ranking_invisible')]"
			}
			blockoverride "onclick_showless" {
				visible = "[Not(GetVariableSystem.Exists('curtiss_schneider_trophy_ranking_invisible'))]"
			}
		}

		flowcontainer = {
			visible = "[GetVariableSystem.Exists('curtiss_schneider_trophy_ranking_invisible')]"
			datamodel = "[JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_ranking_list')]"
			minimumsize = { 520 -1 }
			direction = vertical

			background = {
				using = dark_area
			}

			flowcontainer = {
				direction = vertical

				widget = {
					parentanchor = hcenter
					size = { 500 35 }
					maximumsize = { 500 35 }

					vbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding

						hbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding

							margin_left = 10

							textbox = {
								text = "CURTISS_SCHNEIDER_TROPHY_PARTICIPANT_COUNTRY"
								size = { 220 100% }
								elide = right
								align = nobaseline
								alwaystransparent = yes
								margin_left = 12
							}

							textbox = {
								size = { 170 100% }
								text = "CURTISS_SCHNEIDER_TROPHY_RANKING_CONSECUTIVE_VICTORIES"
								elide = right
								align = right|nobaseline
								margin_right = 10
							}

							textbox = {
								size = { 90 100% }
								text = "CURTISS_SCHNEIDER_TROPHY_RANKING_VICTORIES"
								elide = right
								align = right|nobaseline
								margin_right = 10
							}
						}
					}
				}
			}

			item = {
				flowcontainer = {
					direction = vertical

					divider_clean = {
						parentanchor = top
					}

					widget = {
						parentanchor = hcenter
						size = { 500 35 }
						maximumsize = { 500 35 }
						datacontext = "[Scope.GetCountry]"
						visible = "[Scope.GetCountry.IsValid]"

						vbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding

							hbox = {
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding

								margin_left = 10

								tiny_flag = {}

								textbox = {
									text = "[Country.GetNameNoFormatting]"
									size = { 260 100% }
									elide = right
									align = nobaseline
									parentanchor = vcenter
									alwaystransparent = yes
									margin_left = 12
								}

								textbox = {
									size = { 80 100% }
									text = "CURTISS_SCHNEIDER_TROPHY_RANKING_CONSECUTIVE_VICTORIES_COUNTRY"
									elide = right
									align = right|nobaseline
									margin_right = 10
								}

								textbox = {
									size = { 80 100% }
									text = "CURTISS_SCHNEIDER_TROPHY_RANKING_VICTORIES_COUNTRY"
									elide = right
									align = right|nobaseline
									margin_right = 10
								}
							}
						}
					}
				}
			}
		}
		expand = {}
	}

	### Race Ranking ###
	flowcontainer = {
		direction = vertical

		visible = "[GetScriptedGui('curtiss_schneider_trophy_race_active_sgui').IsShown(GuiScope.SetRoot(JournalEntry.MakeScope).End)]"

		section_header_button = {
			blockoverride "layout" {
				size = { 520 38 }
			}
			blockoverride "left_text" {
				text = "CURTISS_SCHNEIDER_TROPHY_PARTICIPANT_COUNTRIES_HEADER"
			}
			blockoverride "onclick" {
				onclick = "[GetVariableSystem.Toggle('curtiss_schneider_trophy_participants_visible')]"
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(GetVariableSystem.Exists('curtiss_schneider_trophy_participants_visible'))]"
			}
			blockoverride "onclick_showless" {
				visible = "[GetVariableSystem.Exists('curtiss_schneider_trophy_participants_visible')]"
			}
		}

		flowcontainer = {
			visible = "[GetVariableSystem.Exists('curtiss_schneider_trophy_participants_visible')]"
			datamodel = "[JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_participants_list')]"
			minimumsize = { 520 -1 }
			direction = vertical

			background = {
				using = dark_area
			}

			flowcontainer = {
				direction = vertical

				widget = {
					parentanchor = hcenter
					size = { 500 35 }
					maximumsize = { 500 35 }

					vbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding

						hbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding

							margin_left = 10

							textbox = {
								text = "CURTISS_SCHNEIDER_TROPHY_PARTICIPANT_COUNTRY"
								size = { 280 100% }
								elide = right
								align = nobaseline
								alwaystransparent = yes
								margin_left = 12
							}

							textbox = {
								size = { 200 100% }
								text = "CURTISS_SCHNEIDER_TROPHY_PARTICIPANT_POINTS"
								elide = right
								align = right|nobaseline
								margin_right = 10
							}
						}
					}
				}
			}

			item = {
				flowcontainer = {
					direction = vertical

					divider_clean = {
						parentanchor = top
					}

					widget = {
						parentanchor = hcenter
						size = { 500 35 }
						maximumsize = { 500 35 }
						datacontext = "[Scope.GetCountry]"
						visible = "[Scope.GetCountry.IsValid]"

						vbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding

							hbox = {
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding

								margin_left = 10

								tiny_flag = {}

								textbox = {
									text = "[Country.GetNameNoFormatting]"
									size = { 340 100% }
									elide = right
									align = nobaseline
									alwaystransparent = yes
									margin_left = 12
								}

								textbox = {
									size = { 80 100% }
									text = "CURTISS_COUNTRY_SCHNEIDER_TROPHY_POINTS"
									elide = right
									align = right|nobaseline
									margin_right = 10
								}
							}
						}
					}
				}
			}
		}
		expand = {}
	}
}

flowcontainer = {
	name = "widget_curtiss_schneider_trophy_event_list_widget"
	parentanchor = hcenter
	direction = vertical
	spacing = 12
	#visible = "[GetScriptedGui('curtiss_schneider_trophy_race_active_sgui').IsShown(GuiScope.SetRoot(JournalEntry.MakeScope).End)]"
	datacontext = "[JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list')]"

	curtiss_event_list_widget = {}
}

types curtiss_types
{
	### Event List ###
	# Stolen from Manaflow and adapted.
	# Thanks Bahmut | Chris
	type curtiss_event_list_widget = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		oncreate = "[BindFoldOutContext]"

		@log_entry_width = 500
		@log_entry_height = 60
		@log_entry_icon_width = 60
		@log_entry_date_width = 120
		@log_entry_info_width = @[log_entry_width - log_entry_icon_width - log_entry_date_width]

		section_header_button = {
			parentanchor = hcenter
			onclick = "[PdxGuiFoldOut.Toggle]"

			blockoverride "layout" {
				size = { @[layer_width + 30] 38 }
			}
			blockoverride "onclick_showmore" {
				visible = "[Not(PdxGuiFoldOut.IsUnfolded)]"
			}
			blockoverride "onclick_showless" {
				visible = "[PdxGuiFoldOut.IsUnfolded]"
			}
			blockoverride "left_text" {
				text = CURTISS_RACE_EVENTS_HEADER
			}
		}

		flowcontainer = {
			using = default_list_position
			direction = vertical
			margin_top = 5
			margin_bottom = 10

			# Header
			widget = {
				parentanchor = hcenter
				size = { @log_entry_width 30 }
				visible = "[PdxGuiFoldOut.IsUnfolded]"
				hbox = {
					spacing = 2
					layoutpolicy_horizontal = expanding
					button = {
						using = sort_button_bg
						enabled = no
						text = CURTISS_RACE_EVENTS_HEADER_TYPE
						minimumsize = { @log_entry_icon_width 30 }
						maximumsize = { @log_entry_icon_width 30 }
						align = hcenter|nobaseline
						margin_left = 10
						margin_right = 10
						elide = right
					}
					button = {
						using = sort_button_bg
						layoutpolicy_horizontal = expanding
						enabled = no
						text = CURTISS_RACE_EVENTS_HEADER_EVENT
						minimumsize = { -1 30 }
						maximumsize = { -1 30 }
						align = hcenter|nobaseline
						margin_left = 10
						margin_right = 10
						elide = right
					}
					button = {
						using = sort_button_bg
						enabled = no
						text = CURTISS_RACE_EVENTS_HEADER_DATE
						minimumsize = { @log_entry_date_width 30 }
						maximumsize = { @log_entry_date_width 30 }
						align = hcenter|nobaseline
						margin_left = 10
						margin_right = 10
						elide = right
					}
				}
			}

			# Over 10 items
			flowcontainer = {
				using = default_list_position
				visible = "[And3(
					PdxGuiFoldOut.IsUnfolded,
					DataModelHasItems(JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list')),
					GreaterThan_int32(GetDataModelSize(JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list')), '(int32)10')
				)]"
				margin_top = 5
				direction = vertical
				datamodel = "[DataModelLast(JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list'), '(int32)10')]"
				spacing = 5
				bottomtotop = yes

				item = {
					curtiss_event_list_entry_widget = {}
				}
			}
			textbox = {
				visible = "[And3(
					PdxGuiFoldOut.IsUnfolded,
					DataModelHasItems(JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list')),
					GreaterThan_int32(GetDataModelSize(JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list')), '(int32)10')
				)]"
				margin_top = 10
				size = { @log_entry_width 20 }
				text = CURTISS_RACE_EVENTS_ENTRIES_LIMIT
				align = center
			}

			# Under 10 items
			flowcontainer = {
				using = default_list_position
				visible = "[And3(
					PdxGuiFoldOut.IsUnfolded,
					DataModelHasItems(JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list')),
					Not(GreaterThan_int32(GetDataModelSize(JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list')), '(int32)10'))
				)]"
				margin_top = 5
				direction = vertical
				datamodel = "[JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list')]"
				spacing = 5
				bottomtotop = yes

				item = {
					curtiss_event_list_entry_widget = {}
				}
			}

			flowcontainer = {
				using = default_list_position
				visible = "[And(
					PdxGuiFoldOut.IsUnfolded,
					Not(DataModelHasItems(JournalEntry.MakeScope.GetList('curtiss_schneider_trophy_events_list')))
				)]"
				direction = vertical

				textbox = {
					size = { @log_entry_width 80 }
					text = CURTISS_RACE_EVENTS_ENTRIES_EMPTY
					align = center
				}
			}
		}
	}

	type curtiss_event_list_entry_widget = widget {
		size = { @log_entry_width @log_entry_height }

		background = {
			using = dark_area
			margin_left = -25
			alpha = 0.1
			modify_texture = {
				using = simple_frame_mask
			}
		}
		background = {
			using = simple_frame
			margin_left = -25
		}

		flowcontainer = {
			# Icon
			textbox = {
				size = { @log_entry_icon_width @log_entry_height }
				align = center
				raw_text = "[Scope.Var('event_container_icon').GetFlagName]"
				using = fontsize_xxl
				background = {
					margin = { 3 3 }
					texture = "gfx/interface/backgrounds/round_button_bg.dds"
				}
			}
			widget = {
				size = { @log_entry_info_width @log_entry_height }
				# Event Title
				textbox = {
					size = { @[log_entry_info_width - 10] @[log_entry_height / 2] }
					margin_bottom = 4
					parentanchor = right|top
					raw_text = "[Scope.Var('event_container_title_loc').GetFlagName]"
					default_format = "#header"
					align = center
					background = {
						using = default_header_bg_faded
						margin_top = 2
					}
				}
				# Result: text only
				textbox = {
					visible = "[Not(Scope.Var('event_container_outcome_var').IsSet)]"
					size = { @[log_entry_info_width - 10] @[log_entry_height / 2] }
					position = { 0 -2 }
					parentanchor = right|bottom
					raw_text = "[Scope.Var('event_container_loc').GetFlagName]"
					align = center
				}
				# Result: text + value
				widget = {
					visible = "[Scope.Var('event_container_outcome_var').IsSet]"
					size = { @[log_entry_info_width - 10] @[log_entry_height / 2] }
					position = { 0 -2 }
					parentanchor = right|bottom
					flowcontainer = {
						parentanchor = center
						spacing = 5
						textbox = {
							autoresize = yes
							raw_text = "[Scope.Var('event_container_loc').GetFlagName]"
						}
						textbox = {
							autoresize = yes
							raw_text = "[Scope.Var('event_container_outcome_var').GetValue|0+] @curtiss_schneider_point!"
						}
					}
				}
			}
			widget = {
				size = { @log_entry_date_width @log_entry_height }
				textbox = {
					autoresize = yes
					parentanchor = center
					raw_text = "#v [TimeKeeper.GetCurrentDateWithDiff(FixedPointToInt(Scope.ScriptValue('curtiss_schneider_trophy_race_event_time_value')))]#!"
					background = {
						using = entry_bg
						margin = { 10 5 }
					}
				}
			}
		}
	}
}
