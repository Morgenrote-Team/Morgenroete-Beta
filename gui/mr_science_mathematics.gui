types mr_main_science_panel_types {

	type mr_science_mathematics_panel = fullscreen_block_window {
		name = "mr_science_mathematics_panel"
		datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"

		visible = "[GetVariableSystem.HasValue('com_open_window', 'mr_academic_mathematics')]"

		blockoverride "animation_state_block" {
			state = {
				name = _show
				# Close open panel before showing this one
				on_start = "[InformationPanelBar.ClosePanel]"
				on_start = "[MapListPanelManager.CloseCurrentPanel]"
				# Fullscreen panels hide topbar
				on_finish = "[GetVariableSystem.Set('com_fullscreen', 'com_fullscreen')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_world_80"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_vfx_war_100"
				}
			}

			state = {
				name = _hide
				on_start = "[GetVariableSystem.Clear('com_fullscreen')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets_stop"
				}
			}
		}

		blockoverride "window_header_name" {
			text = MR_MATHEMATICAL_FORMULAS
			default_format = "#bold"
		}

		blockoverride "back_button_fullscreen" {
			back_button_large = {
				position = { 11 15 }
				parentanchor = top|left
                onclick = "[GetVariableSystem.Set('com_open_window', 'mr_sidebar_button_science_sgui')]"
				onclick = "[GetVariableSystem.Set('mr_science_tab', 'mathematics')]"
				tooltip = "MR_RETURN_ACADEMY_OF_SCIENCE_TT"
				input_action = "back"
			}
		}

		close_button_large = {
			name = "tutorial_highlight_close_button"
			parentanchor = top|right
			onclick = "[GetVariableSystem.Clear('com_open_window')]"
			onclick = "[GetVariableSystem.Clear('com_alert_action')]"
			onclick = "[GetVariableSystem.Clear('com_fullscreen')]"
			shortcut = "close_window"
			position = { -56 115 }
		}

		blockoverride "close_button_position" {
			visible = no
		}

		blockoverride "fixed_top" {
			flowcontainer = {
				minimumsize = { 100% -1 }
				margin_top = 20
				margin_bottom = 10

				button = {
					#Button to get back to the Academy of Science
					using = default_button_primary_big_action
					size = { 250 40 }
					raw_text = "MR_RETURN_ACADEMY_OF_SCIENCE"
					using = fontsize_medium
					onclick = "[GetVariableSystem.Set('com_open_window', 'mr_sidebar_button_science_sgui')]"
					onclick = "[GetVariableSystem.Set('mr_science_tab', 'mathematics')]"
					tooltip = "MR_RETURN_ACADEMY_OF_SCIENCE_TT"
				}
			}
		}

		blockoverride "scrollarea_content" {
			hbox = {
				margin_left = 10
				margin_bottom = 20
				layoutpolicy_horizontal = growing
				layoutpolicy_vertical = expanding

				#Sidebar
				scrollbox = {

					layoutpolicy_horizontal = growing
					layoutpolicy_vertical = expanding

					scrollbarpolicy_horizontal = always_off
					scrollbarpolicy_vertical = as_needed

					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}

					blockoverride "scrollbox_content" {
						vbox = {
							spacing = 5

							default_header_clean = {
								size = { 910 50 }
								position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_CLASSICAL_PHYSICS"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}


							#Complex Analysis
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_COMPLEX_ANALYSIS_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_COMPLEX_ANALYSIS_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_COMPLEX_ANALYSIS_YEAR"
								}
							}

							#Differential Equations
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_DIFFERENTIAL_EQUATIONS_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_DIFFERENTIAL_EQUATIONS_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_DIFFERENTIAL_EQUATIONS_YEAR"
								}
							}

							#Fourier Analysis
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_FOURIER_ANALYSIS_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_FOURIER_ANALYSIS_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_FOURIER_ANALYSIS_YEAR"
								}
							}

							#Non-Euclidian Geometry
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_NON_EUCLIDIAN_GEOMETRY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_NON_EUCLIDIAN_GEOMETRY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_NON_EUCLIDIAN_GEOMETRY_YEAR"
								}
							}

							#Group Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_GROUP_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_GROUP_THEORY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_GROUP_THEORY_YEAR"
								}
							}

							default_header_clean = {
								size = { 910 50 }
								position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_DIFFERENTIAL_GEOMETRY"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}

							#Linear Algebra
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_LINEAR_ALGEBRA_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_LINEAR_ALGEBRA_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_LINEAR_ALGEBRA_YEAR"
								}
							}

							#Abstract Algebra
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_ABSTRACT_ALGEBRA_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_ABSTRACT_ALGEBRA_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_ABSTRACT_ALGEBRA_YEAR"
								}
							}

							#Navier-Stokes Equations
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_NS_EQUATIONS_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_NS_EQUATIONS_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_NS_EQUATIONS_YEAR"
								}
							}

							#Mathematical Logic
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_MATHEMATICAL_LOGIC_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_MATHEMATICAL_LOGIC_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_MATHEMATICAL_LOGIC_YEAR"
								}
							}

							#Analytical Number Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_ANALYTICAL_NUMBER_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_ANALYTICAL_NUMBER_THEORY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_ANALYTICAL_NUMBER_THEORY_YEAR"
								}
							}

							default_header_clean = {
								size = { 910 50 }
								position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_ELECTROMAGNETISM"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}

							#Algebraic Number Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_ALGEBRAIC_NUMBER_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_ALGEBRAIC_NUMBER_THEORY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_ALGEBRAIC_NUMBER_THEORY_YEAR"
								}
							}

							#EM Field Equations
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_EM_FIELD_EQUATIONS_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_EM_FIELD_EQUATIONS_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_EM_FIELD_EQUATIONS_YEAR"
								}
							}

							#Set Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_SET_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_SET_THEORY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_SET_THEORY_YEAR"
								}
							}

							#Topology
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_TOPOLOGY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_TOPOLOGY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_TOPOLOGY_YEAR"
								}
							}

							#Functional Analysis
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_FUNCTIONAL_ANALYSIS_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_FUNCTIONAL_ANALYSIS_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_FUNCTIONAL_ANALYSIS_YEAR"
								}
							}

							default_header_clean = {
								size = { 910 50 }
								position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_MODERN_PHYSICS"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}

							#Lie Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_LIE_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_LIE_THEORY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_LIE_THEORY_YEAR"
								}
							}

							#Representation Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_REPRESENTATION_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_REPRESENTATION_THEORY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_REPRESENTATION_THEORY_YEAR"
								}
							}

							#Algebraic Topology
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_ALGEBRAIC_TOPOLOGY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_ALGEBRAIC_TOPOLOGY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_ALGEBRAIC_TOPOLOGY_YEAR"
								}
							}

							#Class Field Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_CLASS_FIELD_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_CLASS_FIELD_THEORY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_CLASS_FIELD_THEORY_YEAR"
								}
							}

							#Relativity Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_RELATIVITY_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_RELATIVITY_THEORY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_RELATIVITY_THEORY_YEAR"
								}
							}

							default_header_clean = {
								size = { 910 50 }
								position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_NUCLEAR_PHYSICS"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}

							#Quantum Mechanics
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_QUANTUM_MECHANICS_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_QUANTUM_MECHANICS_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_QUANTUM_MECHANICS_YEAR"
								}
							}

							#Proof Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_PROOF_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_PROOF_THEORY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_PROOF_THEORY_YEAR"
								}
							}

							#Cryptography
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_CRYPTOGRAPHY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_CRYPTOGRAPHY_COUNTRY"
								}
								blockoverride "formula_year" {
									text = "CURIE_FORMULA_CRYPTOGRAPHY_YEAR"
								}
							}

							#Algorithm Theory
							curie_mathematical_formula = {
								blockoverride "formula_name" {
									text = "CURIE_FORMULA_ALGORITHM_THEORY_NAME"
								}
								blockoverride "formula_country" {
									text = "CURIE_FORMULA_ALGORITHM_THEORY_COUNTRY"
								}
