types mr_main_science_panel_types {

	type mr_science_mathematics_panel = fullscreen_block_window {
		name = "mr_science_mathematics_panel"
		datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"

		visible = "[GetVariableSystem.HasValue('com_open_window', 'mr_academic_mathematics')]"

		blockoverride "animation_state_block" {
			state = {
				name = _show
				# Close open panel before showing this one
				on_start = "[InformationPanelBar.ClosePanel]"
				on_start = "[MapListPanelManager.CloseCurrentPanel]"
				# Fullscreen panels hide topbar
				on_finish = "[GetVariableSystem.Set('com_fullscreen', 'com_fullscreen')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_world_80"
				}
				start_sound = {
					soundeffect = "snapshot:/Dynamic/mute_vfx_war_100"
				}
			}

			state = {
				name = _hide
				on_start = "[GetVariableSystem.Clear('com_fullscreen')]"
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/markets_stop"
				}
			}
		}

		blockoverride "window_header_name" {
			text = MR_MATHEMATICAL_FORMULAS
			default_format = "#bold"
		}

		blockoverride "back_button_fullscreen" {
			back_button_large = {
				position = { 11 15 }
				parentanchor = top|left
                onclick = "[GetVariableSystem.Set('com_open_window', 'mr_sidebar_button_science_sgui')]"
				onclick = "[GetVariableSystem.Set('mr_science_tab', 'mathematics')]"
				tooltip = "MR_RETURN_ACADEMY_OF_SCIENCE_TT"
				input_action = "back"
			}
		}

		close_button_large = {
			name = "tutorial_highlight_close_button"
			parentanchor = top|right
			onclick = "[GetVariableSystem.Clear('com_open_window')]"
			onclick = "[GetVariableSystem.Clear('com_alert_action')]"
			onclick = "[GetVariableSystem.Clear('com_fullscreen')]"
			shortcut = "close_window"
			position = { -56 115 }
		}

		blockoverride "close_button_position" {
			visible = no
		}

		blockoverride "fixed_top" {
			flowcontainer = {
				minimumsize = { 100% -1 }
				margin_top = 20
				margin_bottom = 10

				button = {
					#Button to get back to the Academy of Science
					using = default_button_primary_big_action
					size = { 250 40 }
					raw_text = "MR_RETURN_ACADEMY_OF_SCIENCE"
					using = fontsize_medium
					onclick = "[GetVariableSystem.Set('com_open_window', 'mr_sidebar_button_science_sgui')]"
					onclick = "[GetVariableSystem.Set('mr_science_tab', 'mathematics')]"
					tooltip = "MR_RETURN_ACADEMY_OF_SCIENCE_TT"
				}
			}
		}

		blockoverride "scrollarea_content" {
			hbox = {
				margin_left = 10
				margin_bottom = 20
				layoutpolicy_horizontal = growing
				layoutpolicy_vertical = expanding

				#Sidebar
				scrollbox = {

					layoutpolicy_horizontal = growing
					layoutpolicy_vertical = expanding

					scrollbarpolicy_horizontal = always_off
					scrollbarpolicy_vertical = as_needed

					scrollbar_vertical = {
						using = Scrollbar_Vertical
					}

					blockoverride "scrollbox_content" {
						vbox = {
							spacing = 5

							datamodel = "[GetGlobalList('curie_classical_physics_global_list')]"

							default_header_clean = {
								size = { 910 50 }
								#position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_CLASSICAL_PHYSICS"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}

							item = {
								datacontext = "[Scope.GetScriptContainer]"

								flowcontainer = {
									ignoreinvisible = no
									spacing = 10

									textbox = {
										text = "CURIE_FORMULA_ITEM_NAME"
										tooltip = "CURIE_FORMULA_ITEM_TOOLTIP"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_COUNTRY"
										visible = "[Scope.Var('discovering_country').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_INVENTOR"
										visible = "[Scope.Var('discoverer').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_YEAR"
										visible = "[Scope.Var('year').IsSet]"
										parentanchor = top|left
										size = { 50 25 }
										elide = right
										using = fontsize_large
									}
								}
							}
						}
						vbox = {
							spacing = 5

							datamodel = "[GetGlobalList('curie_differential_geometry_global_list')]"

							default_header_clean = {
								size = { 910 50 }
								#position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_DIFFERENTIAL_GEOMETRY"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}

							item = {
								datacontext = "[Scope.GetScriptContainer]"

								flowcontainer = {
									ignoreinvisible = no
									spacing = 10

									textbox = {
										text = "CURIE_FORMULA_ITEM_NAME"
										tooltip = "CURIE_FORMULA_ITEM_TOOLTIP"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_COUNTRY"
										visible = "[Scope.Var('discovering_country').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_INVENTOR"
										visible = "[Scope.Var('discoverer').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_YEAR"
										visible = "[Scope.Var('year').IsSet]"
										parentanchor = top|left
										size = { 50 25 }
										elide = right
										using = fontsize_large
									}
								}
							}
						}
						vbox = {
							spacing = 5

							datamodel = "[GetGlobalList('curie_electromagnetism_global_list')]"

							default_header_clean = {
								size = { 910 50 }
								#position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_ELECTROMAGNETISM"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}

							item = {
								datacontext = "[Scope.GetScriptContainer]"

								flowcontainer = {
									ignoreinvisible = no
									spacing = 10

									textbox = {
										text = "CURIE_FORMULA_ITEM_NAME"
										tooltip = "CURIE_FORMULA_ITEM_TOOLTIP"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_COUNTRY"
										visible = "[Scope.Var('discovering_country').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_INVENTOR"
										visible = "[Scope.Var('discoverer').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_YEAR"
										visible = "[Scope.Var('year').IsSet]"
										parentanchor = top|left
										size = { 50 25 }
										elide = right
										using = fontsize_large
									}
								}
							}
						}
						vbox = {
							spacing = 5

							datamodel = "[GetGlobalList('curie_modern_physics_global_list')]"

							default_header_clean = {
								size = { 910 50 }
								#position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_MODERN_PHYSICS"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}

							item = {
								datacontext = "[Scope.GetScriptContainer]"

								flowcontainer = {
									ignoreinvisible = no
									spacing = 10

									textbox = {
										text = "CURIE_FORMULA_ITEM_NAME"
										tooltip = "CURIE_FORMULA_ITEM_TOOLTIP"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_COUNTRY"
										visible = "[Scope.Var('discovering_country').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_INVENTOR"
										visible = "[Scope.Var('discoverer').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_YEAR"
										visible = "[Scope.Var('year').IsSet]"
										parentanchor = top|left
										size = { 50 25 }
										elide = right
										using = fontsize_large
									}
								}
							}
						}
						vbox = {
							spacing = 5

							datamodel = "[GetGlobalList('curie_nuclear_physics_global_list')]"

							default_header_clean = {
								size = { 910 50 }
								#position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MR_HEADER_NUCLEAR_PHYSICS"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							curie_mathematical_formula = {}

							item = {
								datacontext = "[Scope.GetScriptContainer]"

								flowcontainer = {
									ignoreinvisible = no
									spacing = 10

									textbox = {
										text = "CURIE_FORMULA_ITEM_NAME"
										tooltip = "CURIE_FORMULA_ITEM_TOOLTIP"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_COUNTRY"
										visible = "[Scope.Var('discovering_country').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_INVENTOR"
										visible = "[Scope.Var('discoverer').IsSet]"
										parentanchor = top|left
										size = { 250 25 }
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "CURIE_FORMULA_ITEM_YEAR"
										visible = "[Scope.Var('year').IsSet]"
										parentanchor = top|left
										size = { 50 25 }
										elide = right
										using = fontsize_large
									}
								}
							}
						}
					}
				}

				#Magnetic Association
				expand = {
					flowcontainer = {
						direction = vertical
						ignoreinvisible = yes
						spacing = 10

						#Red Cross
						widget = {
							size = { 880 300 }
							parentanchor = left

							background = {
								using = entry_bg_simple
							}

							default_header_clean = {
								size = { 880 50 }
								position = { 1 -3 }
								blockoverride "text" {
								}
								textbox = {
									text = "MAGNETIC_ASSOCIATION_HEADER_TEXT"
									parentanchor = center
									position = { 0 0 }
									autoresize = yes
									#max_width = 190
									elide = right
									using = fontsize_xxl
								}
							}

							flowcontainer = {
							direction = vertical
							ignoreinvisible = yes
							spacing = 10

							widget = {
								size = { 880 40 }
							}

							flowcontainer = {
								direction = horizontal
								parentanchor = top|hcenter
								ignoreinvisible = yes
								spacing = 30

								widget = {
									size = { 190 190 }

									icon = {
										visible = "[GetScriptedGui('mr_mathematics_magnetic_atlas_active_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
										parentanchor = center
										size = { 190 190 }
										position = { -140 0 }
										texture = "gfx/interface/icons/GUI_icons/GUI_curie_magnetic_association_logo.dds"
									}

									icon = {
										visible = "[GetScriptedGui('mr_mathematics_magnetic_atlas_inactive_sgui').IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
										parentanchor = center
										size = { 190 190 }
										position = { -140 0 }
										texture = "gfx/interface/icons/GUI_icons/GUI_curie_magnetic_association_logo_inactive.dds"
									}
								}

								widget = {
									size = { 250 170 }

									green_progressbar_horizontal = {
										layoutpolicy_horizontal = expanding
										size = { 500 35 }
										position = { -100 10 }
										blockoverride "values" {
											min = 0
											max = 100
											value = "[FixedPointToFloat(Country.MakeScope.Var('dubois_academy_progress').GetValue)]"
										}
										textbox = {
											#max_update_rate = 100
											text = "MR_MAGNETIC_PROGRESS_VALUES"
											tooltip = "MR_MAGNETIC_PROGRESS_TOOLTIP"
											size = { 100% 100% }
											using = fontsize_xl
											align = center
										}
									}

									textbox = {
										text = "MR_MAGNETIC_ASSOCIATION_FOUNDER"
										position = { -100 55 }
										max_width = 250
										autoresize = yes
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "MR_MAGNETIC_ASSOCIATION_SEAT"
										position = { 175 55 }
										max_width = 250
										autoresize = yes
										elide = left
										using = fontsize_large
									}

									textbox = {
										text = "MR_MAGNETIC_ASSOCIATION_DATA"
										position = { -100 95 }
										max_width = 250
										autoresize = yes
										elide = right
										using = fontsize_large
									}

									textbox = {
										text = "MR_MAGNETIC_ASSOCIATION_MEMBERS"
										position = { 175 95 }
										max_width = 250
										autoresize = yes
										elide = left
										using = fontsize_large
									}
								}
							}

							#Convention Buttons
							flowcontainer = {
								direction = horizontal
								ignoreinvisible = yes
								parentanchor = hcenter
								spacing = 30

								#Sign first Convention
								button = {
									using = default_button_primary_big_action
									size = { 250 40 }
									raw_text = "MR_PHYSICIST_FOUND_MAGNETIC_ASSOCIATION_BUTTON"
									using = fontsize_medium

									datacontext = "[GetScriptedGui('mr_physicist_found_magnetic_association_button')]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
									visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
									tooltip = "MR_PHYSICIST_FOUND_MAGNETIC_ASSOCIATION_BUTTON_TT"
								}

								#Sign second Convention
								button = {
									using = default_button_primary_big_action
									size = { 250 40 }
									raw_text = "MR_PHYSICIST_MAGNETIC_RESEARCH_STATION_BUTTON"
									using = fontsize_medium

									datacontext = "[GetScriptedGui('mr_physicist_magnetic_research_station_button')]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
									visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
									tooltip = "MR_PHYSICIST_MAGNETIC_RESEARCH_STATION_BUTTON_TT"
								}


								#Sign third Convention
								button = {
									using = default_button_primary_big_action
									size = { 250 40 }
									raw_text = "MR_PHYSICIST_MAGNETIC_ATLAS_BUTTON"
									using = fontsize_medium

									datacontext = "[GetScriptedGui('mr_physicist_magnetic_atlas_button')]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Country.MakeScope ).End )]"
									visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( Country.MakeScope ).End )]"
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Country.MakeScope ).End )]"
									tooltip = "MR_PHYSICIST_MAGNETIC_ATLAS_BUTTON_TT"
								}

							}
						}
						}
					}
				}
			}
		}
	}

	type curie_mathematical_formula = flowcontainer {
		ignoreinvisible = yes
		spacing = 10

		textbox = {
			block "formula_name" {
				text = "CURIE_FORMULA_NAME"
			}
			parentanchor = top|left
			size = { 250 25 }
			elide = right
			using = fontsize_large
		}

		textbox = {
			block "formula_country" {
				text = "CURIE_FORMULA_COUNTRY"
			}
			parentanchor = top|left
			size = { 250 25 }
			elide = right
			using = fontsize_large
		}

		textbox = {
			block "formula_inventor" {
				text = "CURIE_FORMULA_INVENTOR"
			}
			parentanchor = top|left
			size = { 250 25 }
			elide = right
			using = fontsize_large
		}

		textbox = {
			block "formula_year" {
				text = "CURIE_FORMULA_YEAR"
			}
			parentanchor = top|left
			size = { 50 25 }
			elide = right
			using = fontsize_large
		}
	}
}